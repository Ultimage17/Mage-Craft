    closeModal('discard-modal');
    document.getElementById('discard-modal-title').textContent='Discard Cards';
    render();
    showMessage('Frost Bite used!','success');
  };
  openModal('discard-modal');
}

function confirmDiscard() {
  if(G._discardConfirmHook) { G._discardConfirmHook(); G._discardConfirmHook=null; return; }
  const selected = G._pendingDiscardSelected ? G._pendingDiscardSelected() : [];
  if(selected.length===0) { closeModal('discard-modal'); return; }
  const sorted=[...selected].sort((a,b)=>b-a);
  sorted.forEach(i=>G.discard.push(G.playerHand.splice(i,1)[0]));
  for(let i=0;i<sorted.length;i++) if(G.deck.length||G.discard.length) G.playerHand.push(drawCard());
  closeModal('discard-modal');
  render();
  showMessage(`Discarded ${sorted.length} card(s) and drew replacements.`,'');
}

// ============================================================
// TOKEN USAGE
// ============================================================
function useToken(tokenIdx) {
  if(!G.isPlayerTurn || G.phase!=='action') { showMessage('Can only use tokens on your turn.','error'); return; }
  const tokenType = G.playerTokens[tokenIdx];
  const tok = TOKENS[tokenType];
  switch(tokenType) {
    case 'element': // Arcane Lock
      showSlotPicker('Arcane Lock', 'Lock this slot for opponent\'s next turn', G.slots.map((_,i)=>i), (si)=>{
        G.slots[si].lock = true;
        G.playerTokens.splice(tokenIdx,1);
        closeModal('slot-modal');
        render();
        showMessage('🔒 Slot locked! Opponent cannot change it next turn.','success');
      });
      break;
    case 'number': // Null Sigil — clears slot
      showSlotPicker('Null Sigil', 'Clear this Spell Slot immediately', G.slots.map((_,i)=>i), (si)=>{
        const cleared = G.slots[si].stack;
        G.discard.push(...cleared);
        G.slots[si].stack=[];
        reloadSlot(si);
        G.playerTokens.splice(tokenIdx,1);
        closeModal('slot-modal');
        render();
        showMessage('⚫ Null Sigil — slot cleared!','success');
      });
      break;
    case 'run': // Summon Stone
      {
        const earthCards = G.discard.filter(c=>true); // all discard
        if(G.discard.length===0) { showMessage('Discard pile is empty.','error'); return; }
        const opts = document.getElementById('summon-modal-options');
        opts.innerHTML='';
        // Show unique cards
        const shown = G.discard.slice(-20);
        shown.forEach((card,i)=>{
          const div=document.createElement('div');
          div.className='modal-option';
          div.innerHTML=`<div class="modal-option-title">${cardLabel(card)}</div>`;
          div.onclick=()=>{
            const ri=G.discard.lastIndexOf(card);
            if(ri>=0) G.discard.splice(ri,1);
            G.playerHand.push({...card});
            G.playerTokens.splice(tokenIdx,1);
            closeModal('summon-modal');
            render();
            showMessage('💎 Summon Stone — card retrieved!','success');
          };
          opts.appendChild(div);
        });
        openModal('summon-modal');
      }
      break;
    case 'vertical': // Crystal Ball
      {
        const top3=[];
        for(let i=0;i<3&&(G.deck.length||G.discard.length);i++) top3.push(drawCard());
        G.pendingCrystalCards = top3;
        const opts = document.getElementById('summon-modal-options');
        opts.innerHTML='';
        document.querySelector('#summon-modal .modal-title').textContent='Crystal Ball';
        document.querySelector('#summon-modal .modal-subtitle').textContent='Add one card to your hand, return the rest';
        top3.forEach((card,i)=>{
          const div=document.createElement('div');
          div.className='modal-option';
          div.innerHTML=`<div class="modal-option-title">${cardLabel(card)}</div>`;
          div.onclick=()=>{
            G.playerHand.push({...card});
            const rest=top3.filter((_,j)=>j!==i);
            // Return 2 in any order — just put back on deck bottom for simplicity
            rest.reverse().forEach(c=>G.deck.unshift(c));
            G.playerTokens.splice(tokenIdx,1);
            closeModal('summon-modal');
            document.querySelector('#summon-modal .modal-title').textContent='Summon Stone';
            document.querySelector('#summon-modal .modal-subtitle').textContent='Choose a card from the discard pile';
            render();
            showMessage('🔮 Crystal Ball used!','success');
          };
          opts.appendChild(div);
        });
        openModal('summon-modal');
      }
      break;
    case 'horizontal': // Chaos Rune
      if(G.aiHand.length===0) { showMessage('AI has no cards.','error'); return; }
      {
        const randIdx=Math.floor(Math.random()*G.aiHand.length);
        const discarded=G.aiHand.splice(randIdx,1)[0];
        G.discard.push(discarded);
        G.aiChaosCooldown=true;
        G.playerTokens.splice(tokenIdx,1);
        render();
        showMessage(`🌀 Chaos Rune! Discarded AI\'s ${cardLabel(discarded)}. AI cannot replace until end of their turn.`,'success');
      }
      break;
  }
}

// ============================================================
// VOID MAGE
// ============================================================
function activateVoidMage() {
  if(G.playerVoidUsed) return;
  if(!G.isPlayerTurn || G.phase!=='action') { showMessage('Declare Void Mage at the start of your turn.','error'); return; }
  // Board wipe + 25 pts
  G.playerHand.forEach(c=>G.discard.push(c));
  G.aiHand.forEach(c=>G.discard.push(c));
  G.playerHand=[];
  G.aiHand=[];
  for(let i=0;i<5;i++) { G.discard.push(...G.slots[i].stack); G.slots[i].stack=[]; }
  for(let i=0;i<5;i++) reloadSlot(i);
  G.playerScore+=25;
  G.playerVoidUsed=true;
  // Reset attunement streaks
  G.playerAttunement={typeStreak:0,typeKind:null,methodStreak:0,methodKind:null};
  // Redraw hands
  for(let i=0;i<5;i++) { if(G.deck.length||G.discard.length) G.playerHand.push(drawCard()); }
  for(let i=0;i<5;i++) { if(G.deck.length||G.discard.length) G.aiHand.push(drawCard()); }
  checkTitanLevel(true);
  if(!checkWin()) {
    showMessage('⬛ VOID MAGE ACTIVATED! Board cleared. +25 Points!','success');
    render();
  }
}

