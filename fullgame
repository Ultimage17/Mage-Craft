<script>
// ============================================================
// GAME DATA
// ============================================================
const ELEMENTS = ['fire','water','air','earth'];
const ELEMENT_ICONS = { fire:'🔥', water:'💧', air:'🌪️', earth:'🌿', void:'⬛', none:'✦' };
const ELEMENT_NAMES = { fire:'Fire', water:'Water', air:'Air', earth:'Earth', void:'Void', none:'—' };

const MAGES = [
  { id:'fire', element:'fire', name:'Fire Mage', titan:'Ash Dragon', icon:'🐉', color:'var(--fire-glow)',
    ability15:'Flame Claw: Swap 1 Fire slot card with any card in hand.',
    ability25:'Blazing Heart: Swap up to 3 Fire slot cards.' },
  { id:'water', element:'water', name:'Water Mage', titan:'Frost Leviathan', icon:'🐋', color:'var(--water-glow)',
    ability15:'Frost Bite: Once per turn after drawing, discard 1 and draw 1.',
    ability25:'Frozen Soul: Discard up to 2, draw same amount.' },
  { id:'air', element:'air', name:'Air Mage', titan:'Thunder Eagle', icon:'🦅', color:'var(--air-glow)',
    ability15:'Storm Talon: Move top card of any slot to adjacent slot.',
    ability25:'Storm Mind: Move top card of any slot to any other slot.' },
  { id:'earth', element:'earth', name:'Earth Mage', titan:'Stone Wolf', icon:'🐺', color:'var(--earth-glow)',
    ability15:"Forest Blessing: On clear, search cleared slot's discards for Earth card → place as active.",
    ability25:'Forest Body: On clear, search full discard pile for Earth card → place as active.' }
];

const TOKENS = {
  element: { name:'Arcane Lock', icon:'🔒', desc:'Lock a slot — opponent cannot change its element/number next turn.' },
  number:  { name:'Null Sigil',  icon:'⚫', desc:'Clear a slot immediately (sent to discard, reloaded).' },
  run:     { name:'Summon Stone',icon:'💎', desc:'Search discard pile for any 1 card, add to hand.' },
  vertical:{ name:'Crystal Ball',icon:'🔮', desc:'Look at top 3 deck cards, take 1, return 2 in any order.' },
  horizontal:{ name:'Chaos Rune',icon:'🌀', desc:'Opponent discards a random card, cannot replace until end of their next turn.' }
};

// ============================================================
// GAME STATE
// ============================================================
let G = {};

function initState() {
  G = {
    deck: [], discard: [],
    slots: Array(5).fill(null).map(()=>({ stack:[], lock:null, nulled:false })),
    playerHand: [], aiHand: [],
    playerScore: 0, aiScore: 0,
    playerMage: null, aiMage: null,
    playerTokens: [], aiTokens: [],
    playerAttunement: { typeStreak:0, typeKind:null, methodStreak:0, methodKind:null },
    aiAttunement: { typeStreak:0, typeKind:null, methodStreak:0, methodKind:null },
    playerVoidQual: { element:false, number:false, run:false },
    aiVoidQual: { element:false, number:false, run:false },
    playerVoidUsed: false, aiVoidUsed: false,
    playerChaosRune: false, // cannot draw replacement
    aiChaosRune: false,
    playerTitanLevel: 0, aiTitanLevel: 0, // 0=locked, 1=awakened, 2=enhanced
    turn: 1, isPlayerTurn: true,
    phase: 'draw', // draw, action, resolution, end
    selectedCardIdx: null,
    selectedSlotIdx: null,
    cardsPlayedThisTurn: 0,
    discardUsedThisTurn: false,
    wildPending: null, // { cardIdx, forSlot }
    wildDeclared: null, // { element, number }
    tokenActionPending: null,
    pendingSlotAction: null, // for token slot targeting
    frostBiteUsed: false,
    flameclawUsed: false,
    stormTalonUsed: false,
    wolfBlessingUsed: false,
    pendingWolfSlot: null,
    pendingCrystalCards: [],
    aiChaosCooldown: false,
    playerTitanAbilityUsed: false,
  };
}

// ============================================================
// DECK BUILDING
// ============================================================
function buildDeck() {
  const cards = [];
  // Spell Cards 40
  for(const el of ELEMENTS) {
    for(let n=1;n<=5;n++) {
      cards.push({type:'spell',element:el,number:n});
      cards.push({type:'spell',element:el,number:n});
    }
  }
  // Wild Creature Cards 10
  const wildCreatures = [
    {type:'wild',element:'fire',name:'Wyvern'},
    {type:'wild',element:'fire',name:'Wyvern'},
    {type:'wild',element:'water',name:'Kelpie'},
    {type:'wild',element:'water',name:'Kelpie'},
    {type:'wild',element:'air',name:'Harpy'},
    {type:'wild',element:'air',name:'Harpy'},
    {type:'wild',element:'earth',name:'Golem'},
    {type:'wild',element:'earth',name:'Golem'},
    {type:'wild',element:'void',name:'Primal Spirit',isUltimate:true},
    {type:'wild',element:'void',name:'Primal Spirit',isUltimate:true},
  ];
  wildCreatures.forEach(c=>cards.push({...c,number:null,declaredElement:null,declaredNumber:null}));
  // Field Cards 10
  for(const el of [...ELEMENTS,'void']) {
    cards.push({type:'field',element:el,number:null});
    cards.push({type:'field',element:el,number:null});
  }
  return shuffle(cards);
}

function shuffle(arr) {
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
  return a;
}

function drawCard() {
  if(G.deck.length===0) reshuffleDeck();
  return G.deck.pop();
}

function reshuffleDeck() {
  G.deck = shuffle([...G.discard]);
  G.discard = [];
  showMessage('Discard pile reshuffled into draw deck.','');
}

// ============================================================
// SLOT HELPERS
// ============================================================
function slotTop(slot) { return slot.stack.length ? slot.stack[slot.stack.length-1] : null; }
function slotElement(slot) {
  const t = slotTop(slot);
  if(!t) return null;
  if(t.type==='field') return t.element;
  if(t.type==='wild') return t.declaredElement || null;
  return t.element;
}
function slotNumber(slot) {
  const t = slotTop(slot);
  if(!t) return null;
  if(t.type==='field') return null;
  if(t.type==='wild') return t.declaredNumber || null;
  return t.number;
}
function reloadSlot(idx) {
  const c = drawCard();
  c.declaredElement = null; c.declaredNumber = null;
  G.slots[idx].stack = [c];
}

// ============================================================
// PLACEMENT VALIDATION
// ============================================================
function canPlayCard(card, slotIdx) {
  const slot = G.slots[slotIdx];
  if(slot.lock && G.isPlayerTurn) return false; // locked by opponent
  if(card.type==='field') return true;
  if(card.type==='wild' && card.isUltimate) return true; // ultimate wild can go anywhere
  const top = slotTop(slot);
  if(!top) return true; // empty slot
  const topEl = slotElement(slot);
  const topNum = slotNumber(slot);
  // Wild element card: can go if element matches
  if(card.type==='wild') {
    if(card.element==='void') return true;
    if(topEl === card.element) return true;
    if(topNum !== null) return true; // can match number by declaration
    return false;
  }
  // Spell card: number match or element match
  if(topEl === card.element) return true; // element switch
  if(topNum !== null && topNum === card.number) return true; // number switch
  return false;
}

function getPlayableSlots(card) {
  return G.slots.map((_,i)=>i).filter(i=>canPlayCard(card,i));
}

// ============================================================
// PLAYING A CARD
// ============================================================
function placeCard(card, slotIdx) {
  const slot = G.slots[slotIdx];
  // Void field card clears slot
  if(card.type==='field' && card.element==='void') {
    const cleared = slot.stack;
    G.discard.push(...cleared);
    reloadSlot(slotIdx);
    return;
  }
  // Field card — changes element, removes number
  if(card.type==='field') {
    slot.stack.push({...card});
    return;
  }
  slot.stack.push({...card});
}

// ============================================================
// COMBO DETECTION
// ============================================================
function detectCombos() {
  const results = [];
  // Vertical combos (within each slot)
  for(let i=0;i<5;i++) {
    if(G.slots[i].nulled) continue;
    const combos = detectVerticalCombos(G.slots[i].stack, i);
    results.push(...combos);
  }
  // Horizontal combos
  const hCombos = detectHorizontalCombos();
  results.push(...hCombos);
  return results;
}

function getCardEl(card) {
  if(!card) return null;
  if(card.type==='field') return card.element==='void'?null:card.element;
  if(card.type==='wild') return card.declaredElement || card.element;
  return card.element;
}
function getCardNum(card) {
  if(!card) return null;
  if(card.type==='field') return null;
  if(card.type==='wild') return card.declaredNumber||null;
  return card.number;
}

function detectVerticalCombos(stack, slotIdx) {
  const combos = [];
  if(stack.length < 3) return combos;
  // Check all windows of 3,4,5
  for(let len=5;len>=3;len--) {
    for(let start=stack.length-len;start>=0;start--) {
      const window = stack.slice(start, start+len);
      const els = window.map(getCardEl);
      const nums = window.map(getCardNum);
      // Twin Ultimates (len 2+ but check whole stack)
      if(len===2) continue;
      // Element Chain
      if(els.every(e=>e&&e===els[0])) {
        const pts = len===3?3:len===4?4:5;
        combos.push({type:'element-chain',len,pts,slotIdx,start,kind:'element',method:'vertical'});
      }
      // Number Chain
      if(nums.every(n=>n!==null&&n===nums[0])) {
        const pts = len===3?4:len===4?5:6;
        combos.push({type:'number-chain',len,pts,slotIdx,start,kind:'number',method:'vertical'});
      }
      // Run
      const validNums = nums.filter(n=>n!==null);
      if(validNums.length===len && isConsecutive(validNums)) {
        const pts = len===3?3:len===4?5:7;
        combos.push({type:'run',len,pts,slotIdx,start,kind:'run',method:'vertical'});
      }
    }
  }
  // Twin Ultimates — both in same stack
  const ultimates = stack.filter(c=>c.type==='wild'&&c.isUltimate);
  if(ultimates.length>=2) {
    combos.push({type:'twin-ultimates',len:2,pts:8,slotIdx,start:0,kind:'element',method:'vertical'});
  }
  return combos;
}

function isConsecutive(nums) {
  const sorted = [...nums].sort((a,b)=>a-b);
  for(let i=1;i<sorted.length;i++) if(sorted[i]!==sorted[i-1]+1) return false;
  return true;
}

function detectHorizontalCombos() {
  const combos = [];
  const tops = G.slots.map(s=>slotTop(s));
  const els = G.slots.map(s=>slotElement(s));
  const nums = G.slots.map(s=>slotNumber(s));
  // Check nulled slots
  const active = G.slots.map((s,i)=>!s.nulled);
  // Element rows (3,4,5 adjacent)
  for(let len=5;len>=3;len--) {
    for(let start=0;start<=5-len;start++) {
      const idxs = Array.from({length:len},(_,i)=>start+i);
      if(idxs.some(i=>!active[i])) continue;
      const slEls = idxs.map(i=>els[i]);
      if(slEls.every(e=>e&&e===slEls[0])) {
        const pts = len===3?4:len===4?7:10;
        combos.push({type:'element-row',len,pts,slotIdxs:idxs,kind:'element',method:'horizontal'});
      }
      const slNums = idxs.map(i=>nums[i]);
      if(slNums.every(n=>n!==null&&n===slNums[0])) {
        const pts = len===3?5:len===4?8:12;
        combos.push({type:'number-row',len,pts,slotIdxs:idxs,kind:'number',method:'horizontal'});
      }
      if(slNums.every(n=>n!==null) && isConsecutive(slNums)) {
        const pts = len===3?6:len===4?9:13;
        combos.push({type:'number-run',len,pts,slotIdxs:idxs,kind:'run',method:'horizontal'});
      }
    }
  }
  // Elemental Set (Fire+Water+Air+Earth anywhere in top 4 of 5 slots)
  const uniqueEls = new Set(els.filter(e=>e&&ELEMENTS.includes(e)));
  if(uniqueEls.size===4) {
    const idxs = ELEMENTS.map(el=>els.indexOf(el)).filter(i=>i>=0);
    combos.push({type:'elemental-set',pts:8,slotIdxs:idxs,kind:'element',method:'horizontal'});
  }
  // Perfect Harmony: 4 same + ultimate wild on top
  for(let len=4;len<=4;len++) {
    for(let start=0;start<=5-len;start++) {
      const idxs = Array.from({length:len+1},(_,i)=>start+i).filter(i=>i<5);
      if(idxs.length<5) continue;
      const hasFourSame = (() => {
        for(const el of ELEMENTS) {
          const matching = idxs.filter(i=>els[i]===el);
          if(matching.length>=4) {
            const remaining = idxs.filter(i=>els[i]!==el);
            if(remaining.length===1 && tops[remaining[0]] && tops[remaining[0]].type==='wild' && tops[remaining[0]].isUltimate) return true;
          }
        }
        return false;
      })();
      if(hasFourSame) combos.push({type:'perfect-harmony',pts:11,slotIdxs:idxs,kind:'element',method:'horizontal'});
    }
  }
  return combos;
}

// ============================================================
// SCORING
// ============================================================
function scoreCombo(combo, isPlayer) {
  let pts = combo.pts;
  // Dragon enhanced ability fires from dragon passive not here
  if(isPlayer && G.playerMage.id==='fire' && G.playerTitanLevel>=1 && combo.kind==='element' && combo.method==='horizontal') {
    // Dragon doesn't add pts in this version — ability is active swap
  }
  if(isPlayer) G.playerScore += pts;
  else G.aiScore += pts;

  // Attunement tracking
  updateAttunement(isPlayer, combo.kind, combo.method);
  // Void qual tracking
  updateVoidQual(isPlayer, combo);

  // Clear scored slots
  if(combo.slotIdxs) {
    const uniqueSlots = [...new Set(combo.slotIdxs)];
    uniqueSlots.forEach(i=>clearSlot(i, isPlayer));
  } else if(combo.slotIdx !== undefined) {
    clearSlot(combo.slotIdx, isPlayer);
  }

  // Check titan awakening
  checkTitanLevel(isPlayer);
  checkWin();
}

function clearSlot(idx, isPlayer) {
  const slot = G.slots[idx];
  G.discard.push(...slot.stack);
  slot.stack = [];
  slot.lock = null;
  slot.nulled = false;
  // Wolf ability
  if(isPlayer && G.playerMage.id==='earth' && G.playerTitanLevel>=1 && !G.wolfBlessingUsed) {
    triggerWolfBlessing(idx);
    return;
  }
  reloadSlot(idx);
}

function triggerWolfBlessing(slotIdx) {
  G.pendingWolfSlot = slotIdx;
  // Find earth cards in discard
  const pool = G.playerTitanLevel>=2 ? G.discard : G.discard; // both levels use discard (blessing uses cleared slot cards which are now in discard)
  const earthCards = G.discard.filter(c=>getCardEl(c)==='earth');
  if(earthCards.length===0) { reloadSlot(slotIdx); return; }
  const opts = document.getElementById('wolf-modal-options');
  opts.innerHTML = '';
  earthCards.forEach((card,i)=>{
    const div = document.createElement('div');
    div.className = 'modal-option';
    div.innerHTML = `<div class="modal-option-title">${cardLabel(card)}</div>`;
    div.onclick = ()=>{
      // Remove from discard
      const realIdx = G.discard.lastIndexOf(card);
      if(realIdx>=0) G.discard.splice(realIdx,1);
      G.slots[slotIdx].stack = [{...card}];
      G.wolfBlessingUsed = true;
      closeModal('wolf-modal');
      render();
    };
    opts.appendChild(div);
  });
  openModal('wolf-modal');
}

function updateAttunement(isPlayer, kind, method) {
  const att = isPlayer ? G.playerAttunement : G.aiAttunement;
  const tokenList = isPlayer ? G.playerTokens : G.aiTokens;

  // Type streak
  if(att.typeKind===kind) {
    att.typeStreak++;
  } else {
    att.typeStreak = 1; att.typeKind = kind;
  }
  if(att.typeStreak>=3) {
    awardToken(isPlayer, kind, tokenList);
    att.typeStreak = 0;
  }

  // Method streak
  if(att.methodKind===method) {
    att.methodStreak++;
  } else {
    att.methodStreak = 1; att.methodKind = method;
  }
  if(att.methodStreak>=3) {
    awardToken(isPlayer, method, tokenList);
    att.methodStreak = 0;
  }
}

function awardToken(isPlayer, tokenType, tokenList) {
  if(tokenList.length>=2) {
    tokenList.shift(); // discard oldest
  }
  tokenList.push(tokenType);
  if(isPlayer) showMessage(`✨ Attunement! Earned: ${TOKENS[tokenType].name}`, 'success');
}

function updateVoidQual(isPlayer, combo) {
  const qual = isPlayer ? G.playerVoidQual : G.aiVoidQual;
  if(['element-chain','element-row','elemental-set','perfect-harmony'].includes(combo.type)) {
    if(combo.len===5 || combo.type==='elemental-set' || combo.type==='perfect-harmony') qual.element = true;
  }
  if(['number-chain','number-row'].includes(combo.type) && combo.len===5) qual.number = true;
  if(['run','number-run'].includes(combo.type) && combo.len===5) qual.run = true;
}

function checkTitanLevel(isPlayer) {
  const score = isPlayer ? G.playerScore : G.aiScore;
  const prev = isPlayer ? G.playerTitanLevel : G.aiTitanLevel;
  let level = 0;
  if(score>=25) level=2; else if(score>=15) level=1;
  if(level>prev) {
    if(isPlayer) G.playerTitanLevel=level;
    else G.aiTitanLevel=level;
    const mage = isPlayer ? G.playerMage : G.aiMage;
    const msg = level===2 ? `🌟 ${mage.titan} enhanced! (${mage.ability25})` : `⚡ ${mage.titan} awakened! (${mage.ability15})`;
    showMessage(msg, 'success');
  }
}

function checkWin() {
  if(G.playerScore>=50) { showWin(true); return true; }
  if(G.aiScore>=50) { showWin(false); return true; }
  return false;
}

// ============================================================
// MAGE SELECT UI
// ============================================================
function renderMageSelect() {
  const grid = document.getElementById('mage-grid');
  grid.innerHTML = '';
  MAGES.forEach(m=>{
    const div = document.createElement('div');
    div.className = `mage-card${G.aiMage&&G.aiMage.id===m.id?' disabled':''}`;
    div.dataset.element = m.element;
    div.dataset.id = m.id;
    div.innerHTML = `
      <div class="mage-icon">${m.icon}</div>
      <div class="mage-name">${m.name}</div>
      <div class="mage-titan">${m.titan}</div>
      <div class="mage-ability" style="color:${m.color}">${m.ability15}</div>
      <div class="mage-ability" style="color:var(--text3);margin-top:2px">${m.ability25}</div>
    `;
    div.onclick = ()=>{
      document.querySelectorAll('.mage-card').forEach(c=>c.classList.remove('selected'));
      div.classList.add('selected');
      G.playerMage = m;
      document.getElementById('start-game-btn').disabled = false;
    };
    grid.appendChild(div);
  });
}

// ============================================================
// GAME START
// ============================================================
function startGame() {
  if(!G.playerMage) return;
  // AI picks a different mage
  const available = MAGES.filter(m=>m.id!==G.playerMage.id);
  G.aiMage = available[Math.floor(Math.random()*available.length)];
  // Build and deal
  G.deck = buildDeck();
  for(let i=0;i<5;i++) G.playerHand.push(drawCard());
  for(let i=0;i<5;i++) G.aiHand.push(drawCard());
  // Initial slot load
  for(let i=0;i<5;i++) reloadSlot(i);
  showScreen('game-screen');
  G.isPlayerTurn = Math.random()<0.5;
  if(G.isPlayerTurn) {
    G.phase = 'action';
    showMessage("Your turn! Play cards or end your turn.",'');
  } else {
    showMessage("AI goes first...",'');
    setTimeout(()=>doAiTurn(), 1000);
  }
  render();
}

// ============================================================
// RENDER
// ============================================================
function render() {
  renderScores();
  renderSlots();
  renderPlayerHand();
  renderAiHand();
  renderAttunement();
  renderTokens();
  renderVoidMageBtn();
  renderActionBar();
  document.getElementById('turn-num').textContent = G.turn;
  document.getElementById('current-turn-label').textContent = G.isPlayerTurn ? 'Your Turn' : "AI's Turn";
  document.getElementById('phase-label').textContent = phaseLabel();
  document.getElementById('cards-played-label').textContent = `${G.cardsPlayedThisTurn}/5 played`;
}

function phaseLabel() {
  if(!G.isPlayerTurn) return 'AI Thinking...';
  return G.phase==='action' ? 'Action Phase' : G.phase==='draw' ? 'Draw Phase' : 'Resolution';
}

function renderScores() {
  document.getElementById('player-score').textContent = G.playerScore;
  document.getElementById('ai-score').textContent = G.aiScore;
  const pb = document.getElementById('player-titan-badge');
  const ab = document.getElementById('ai-titan-badge');
  const renderBadge = (el, mage, level) => {
    if(!mage) return;
    if(level===0) { el.textContent='🔒 Locked'; el.className='titan-badge'; }
    else if(level===1) { el.textContent=`⚡ ${mage.icon} Awakened`; el.className='titan-badge awakened'; }
    else { el.textContent=`🌟 ${mage.icon} Enhanced`; el.className='titan-badge enhanced'; }
  };
  if(G.playerMage) renderBadge(pb, G.playerMage, G.playerTitanLevel);
  if(G.aiMage) renderBadge(ab, G.aiMage, G.aiTitanLevel);
}

function renderSlots() {
  const row = document.getElementById('slots-row');
  row.innerHTML = '';
  G.slots.forEach((slot,i)=>{
    const div = document.createElement('div');
    div.className = 'spell-slot';
    if(slot.lock) div.classList.add('locked');
    if(slot.nulled) div.classList.add('nulled');
    if(G.selectedSlotIdx===i) div.classList.add('selected-slot');

    const top = slotTop(slot);
    const el = slotElement(slot);
    const num = slotNumber(slot);

    if(top) {
      if(top.type==='wild' && !top.declaredElement && !top.declaredNumber) {
        div.innerHTML=`<div class="slot-element-display el-void">WILD</div><div class="slot-stack-count">Stack: ${slot.stack.length}</div>`;
      } else if(top.type==='field') {
        div.innerHTML=`<div style="font-size:20px">${ELEMENT_ICONS[top.element]}</div><div class="slot-element-display el-${el}">${ELEMENT_NAMES[el]||'—'}</div><div class="slot-stack-count">Field • ${slot.stack.length}</div>`;
      } else {
        div.innerHTML=`<div class="slot-number-display el-${el}">${num||'?'}</div><div style="font-size:14px">${ELEMENT_ICONS[el]||''}</div><div class="slot-element-display el-${el}">${ELEMENT_NAMES[el]||'—'}</div><div class="slot-stack-count">Stack: ${slot.stack.length}</div>`;
      }
    } else {
      div.innerHTML=`<div class="slot-empty-label">Empty</div>`;
    }
    if(slot.lock) div.innerHTML+=`<div class="slot-lock-icon">🔒</div>`;
    if(slot.nulled) div.innerHTML+=`<div class="slot-lock-icon">⚫</div>`;

    div.onclick = ()=>handleSlotClick(i);
    row.appendChild(div);
  });
}

function renderPlayerHand() {
  const hand = document.getElementById('player-hand');
  hand.innerHTML = '';
  G.playerHand.forEach((card,i)=>{
    const div = document.createElement('div');
    div.className = `card ${card.element}-card${card.type==='wild'?' wild-card':''}`;
    if(G.selectedCardIdx===i) div.classList.add('selected');
    div.innerHTML = cardInnerHTML(card);
    div.onclick = ()=>handleCardClick(i);
    hand.appendChild(div);
  });
}

function cardInnerHTML(card) {
  if(card.type==='field') {
    return `<div class="card-icon">${ELEMENT_ICONS[card.element]}</div><div class="card-element el-${card.element}">Field</div><div class="card-type-label">${ELEMENT_NAMES[card.element]}</div>`;
  }
  if(card.type==='wild') {
    const el = card.declaredElement||card.element;
    const num = card.declaredNumber||'?';
    const label = card.isUltimate ? 'Primal' : card.name||'Wild';
    return `<div class="card-corner">${ELEMENT_ICONS[el]}</div><div class="card-number el-${el}">${num}</div><div class="card-element el-${el}">${card.isUltimate?'Primal':'Wild'}</div><div class="card-type-label">${label}</div>`;
  }
  return `<div class="card-corner">${ELEMENT_ICONS[card.element]}</div><div class="card-number el-${card.element}">${card.number}</div><div class="card-icon" style="font-size:14px">${ELEMENT_ICONS[card.element]}</div><div class="card-element el-${card.element}">${ELEMENT_NAMES[card.element]}</div>`;
}

function cardLabel(card) {
  if(card.type==='field') return `${ELEMENT_ICONS[card.element]} ${ELEMENT_NAMES[card.element]} Field`;
  if(card.type==='wild') return card.isUltimate ? `⬛ Primal Spirit (Wild)` : `${ELEMENT_ICONS[card.element]} ${card.name} (Wild)`;
  return `${ELEMENT_ICONS[card.element]} ${ELEMENT_NAMES[card.element]} ${card.number}`;
}

