  G._wildChosenEl = card.isUltimate ? null : card.element;
  G._wildChosenNum = null;

  if(card.isUltimate) {
    els.forEach(el=>{
      const btn=document.createElement('div');
      btn.className='declare-el';
      btn.style.color=`var(--${el}-glow)`;
      btn.innerHTML=`${ELEMENT_ICONS[el]}<br><span style="font-size:10px">${ELEMENT_NAMES[el]}</span>`;
      btn.onclick=()=>{
        document.querySelectorAll('.declare-el').forEach(b=>b.style.borderColor='var(--border2)');
        btn.style.borderColor='var(--gold)';
        G._wildChosenEl=el;
      };
      elRow.appendChild(btn);
    });
  }

  for(let n=1;n<=5;n++) {
    const btn=document.createElement('div');
    btn.className='declare-btn';
    btn.textContent=n;
    btn.onclick=()=>{
      document.querySelectorAll('.declare-btn').forEach(b=>b.style.borderColor='var(--border2)');
      btn.style.borderColor='var(--gold)';
      G._wildChosenNum=n;
    };
    numGrid.appendChild(btn);
  }
  openModal('wild-modal');
}

function confirmWild() {
  if(!G._wildChosenEl || !G._wildChosenNum) { showMessage('Choose both element and number.','error'); return; }
  const {cardIdx,forSlot}=G.wildPending;
  G.playerHand[cardIdx].declaredElement=G._wildChosenEl;
  G.playerHand[cardIdx].declaredNumber=G._wildChosenNum;
  closeModal('wild-modal');
  commitPlay(cardIdx, forSlot);
}

// ============================================================
// END TURN
// ============================================================
function endPlayerTurn() {
  if(!G.isPlayerTurn) return;
  // Clear slot locks/nulls from this turn that were set by opponent (they lasted 1 opponent turn)
  G.slots.forEach(s=>{ s.lock=false; s.nulled=false; });
  G.isPlayerTurn=false;
  G.turn++;
  G.cardsPlayedThisTurn=0;
  G.flameclawUsed=false; G.frostBiteUsed=false; G.stormTalonUsed=false; G.wolfBlessingUsed=false;
  G.playerTitanAbilityUsed=false;
  G.phase='action';
  render();
  showMessage("AI is thinking...",'');
  setTimeout(()=>doAiTurn(), 800);
}

// ============================================================
// AI TURN
// ============================================================
function doAiTurn() {
  // Draw
  while(G.aiHand.length<5 && !G.aiChaosCooldown) {
    if(!G.deck.length && !G.discard.length) break;
    G.aiHand.push(drawCard());
  }
  G.aiChaosCooldown=false;

  // Frost Bite
  if(G.aiMage.id==='water' && G.aiTitanLevel>=1) {
    const max=G.aiTitanLevel>=2?2:1;
    // discard worst cards (highest numbers if focusing on small runs, simplified)
    const toDiscard=G.aiHand.filter(c=>c.type==='spell').slice(0,max);
    toDiscard.forEach(c=>{G.discard.push(c);G.aiHand.splice(G.aiHand.indexOf(c),1);G.aiHand.push(drawCard());});
  }

  // Void Mage check
  const avq=G.aiVoidQual;
  if(!G.aiVoidUsed && avq.element && avq.number && avq.run && G.aiScore+25>=50) {
    aiActivateVoidMage();
    return;
  }

  // Simple AI: try to play cards that create combos, else play anything
  let played=0;
  const maxPlays=5;
  while(played<maxPlays && G.aiHand.length>0) {
    const move=findBestAiMove();
    if(!move) break;
    const {cardIdx,slotIdx}=move;
    const card=G.aiHand.splice(cardIdx,1)[0];
    // Auto-declare wilds
    if(card.type==='wild') {
      if(card.isUltimate) { card.declaredElement=ELEMENTS[Math.floor(Math.random()*4)]; card.declaredNumber=Math.ceil(Math.random()*5); }
      else { card.declaredElement=card.element; card.declaredNumber=Math.ceil(Math.random()*5); }
    }
    placeCard(card,slotIdx);
    played++;
    const combos=detectCombos();
    if(combos.length>0) {
      combos.forEach(c=>{ showComboFlash(c); scoreCombo(c,false); });
      if(checkWin()) return;
    }
    render();
  }

  // AI use token
  if(G.aiTokens.length>0) {
    const tok=G.aiTokens[0];
    if(tok==='element') {
      // Lock a slot the player might use
      const si=Math.floor(Math.random()*5);
      G.slots[si].lock=true;
      G.aiTokens.shift();
    } else if(tok==='number') {
      // Null a slot
      const si=Math.floor(Math.random()*5);
      G.discard.push(...G.slots[si].stack);
      G.slots[si].stack=[];
      reloadSlot(si);
      G.aiTokens.shift();
    }
  }

  // Reset for player
  G.slots.forEach(s=>{s.lock=false;s.nulled=false;});
  G.isPlayerTurn=true;
  G.cardsPlayedThisTurn=0;
  G.flameclawUsed=false;G.frostBiteUsed=false;G.stormTalonUsed=false;G.wolfBlessingUsed=false;
  G.phase='action';

  // Player draws
  while(G.playerHand.length<5) {
    if(!G.deck.length && !G.discard.length) break;
    G.playerHand.push(drawCard());
  }

  render();
  showMessage('Your turn! Play up to 5 cards.','');
}

function findBestAiMove() {
  // Try each card in each slot, score moves by potential
  let best=null; let bestScore=-1;
  G.aiHand.forEach((card,ci)=>{
    for(let si=0;si<5;si++){
      if(!canPlayCard(card,si)) continue;
      // Simulate play
      const simCard={...card};
      if(simCard.type==='wild') {
        if(simCard.isUltimate){ simCard.declaredElement=ELEMENTS[0]; simCard.declaredNumber=3; }
        else { simCard.declaredElement=simCard.element; simCard.declaredNumber=3; }
      }
      const origStack=[...G.slots[si].stack];
      G.slots[si].stack=[...origStack,simCard];
      const combos=detectCombos();
      const pts=combos.reduce((s,c)=>s+c.pts,0);
      G.slots[si].stack=origStack;
      if(pts>bestScore||(pts===0&&bestScore<0)) { bestScore=pts; best={cardIdx:ci,slotIdx:si}; }
    }
  });
  return best;
}

function aiActivateVoidMage() {
  G.playerHand.forEach(c=>G.discard.push(c)); G.aiHand.forEach(c=>G.discard.push(c));
  G.playerHand=[]; G.aiHand=[];
  for(let i=0;i<5;i++){G.discard.push(...G.slots[i].stack);G.slots[i].stack=[];}
  for(let i=0;i<5;i++) reloadSlot(i);
  G.aiScore+=25;
  G.aiVoidUsed=true;
  G.aiAttunement={typeStreak:0,typeKind:null,methodStreak:0,methodKind:null};
  for(let i=0;i<5;i++){if(G.deck.length||G.discard.length)G.aiHand.push(drawCard());}
  for(let i=0;i<5;i++){if(G.deck.length||G.discard.length)G.playerHand.push(drawCard());}
  checkTitanLevel(false);
  if(!checkWin()){
    showMessage('⬛ AI activated Void Mage! Board cleared. AI +25 Points!','error');
    G.isPlayerTurn=true; G.cardsPlayedThisTurn=0; G.phase='action';
    render();
  }
}

// ============================================================
// TITAN ABILITY BUTTONS — accessible via hand-label tap
// ============================================================
document.querySelector('.hand-label')?.addEventListener('click', ()=>{
  if(!G.isPlayerTurn || !G.playerMage) return;
  const m=G.playerMage;
  if(G.playerTitanLevel===0) { showMessage('Titan not yet awakened (need 15 pts).','error'); return; }
  if(m.id==='fire') triggerFlameClawUI();
  else if(m.id==='water') triggerFrostBiteUI();
  else if(m.id==='air') triggerStormTalonUI();
  else showMessage('Wolf ability triggers automatically on slot clear.','');
});

// ============================================================
// SHOW/HIDE HELPERS
// ============================================================
function showSlotPicker(title, subtitle, validSlots, cb) {
  document.getElementById('slot-modal-title').textContent=title;
  document.getElementById('slot-modal-subtitle').textContent=subtitle;
  const opts=document.getElementById('slot-modal-options');
  opts.innerHTML='';
  validSlots.forEach(si=>{
    const slot=G.slots[si];
    const top=slotTop(slot);
    const div=document.createElement('div');
    div.className='modal-option';
    div.innerHTML=`<div class="modal-option-title">Slot ${si+1}</div><div class="modal-option-desc">${top?cardLabel(top):'Empty'} (Stack: ${slot.stack.length})</div>`;
    div.onclick=()=>cb(si);
    opts.appendChild(div);
  });
  openModal('slot-modal');
}

function showHandPicker(subtitle, cb) {
  document.getElementById('slot-modal-title').textContent='Choose from Hand';
  document.getElementById('slot-modal-subtitle').textContent=subtitle;
  const opts=document.getElementById('slot-modal-options');
  opts.innerHTML='';
  G.playerHand.forEach((card,i)=>{
    const div=document.createElement('div');
    div.className='modal-option';
    div.innerHTML=`<div class="modal-option-title">${cardLabel(card)}</div>`;
    div.onclick=()=>{ closeModal('slot-modal'); cb(i); };
    opts.appendChild(div);
  });
  openModal('slot-modal');
}

function openModal(id) { document.getElementById(id).classList.add('active'); }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }

function showComboFlash(combo) {
  const el=document.createElement('div');
  el.className='combo-flash';
  const name = comboName(combo);
  el.innerHTML=`<div class="combo-flash-title">${name}</div><div class="combo-flash-pts">+${combo.pts} pts</div>`;
  document.body.appendChild(el);
  setTimeout(()=>el.remove(), 1600);
}

function comboName(c) {
  const names={
    'element-chain':`Element Chain (${c.len})`,
    'number-chain':`Number Chain (${c.len})`,
    'run':`Run of ${c.len}`,
    'element-row':`Element Row (${c.len})`,
    'number-row':`Number Row (${c.len})`,
    'number-run':`Number Run (${c.len})`,
    'twin-ultimates':'Twin Ultimates!',
    'elemental-set':'Elemental Set!',
    'perfect-harmony':'Perfect Harmony!'
  };
  return names[c.type]||c.type;
}

function showMessage(msg, type='') {
  const el=document.getElementById('game-message');
  el.textContent=msg;
  el.className=`game-message${type?' '+type:''}`;
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(id==='title-screen') { initState(); }
  if(id==='mage-screen') { initState(); G.playerMage=null; renderMageSelect(); }
}

function showWin(playerWon) {
  document.getElementById('win-emblem').textContent = playerWon ? '🏆' : '💀';
  document.getElementById('win-title').textContent = playerWon ? 'Victory!' : 'Defeat';
  document.getElementById('win-subtitle').textContent = playerWon ? 'The elements bow to your mastery.' : 'The AI mage prevails... for now.';
  document.getElementById('final-player-score').textContent = G.playerScore;
  document.getElementById('final-ai-score').textContent = G.aiScore;
  setTimeout(()=>showScreen('win-screen'), 800);
}

