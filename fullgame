// ============================================================
// PLAYER INTERACTIONS
// ============================================================
function handleCardClick(idx) {
  if(!G.isPlayerTurn || G.phase!=='action') return;
  G.selectedCardIdx = G.selectedCardIdx===idx ? null : idx;
  G.selectedSlotIdx = null;
  render();
  if(G.selectedCardIdx!==null) showMessage('Now tap a Spell Slot to play this card.','');
  else showMessage('','');
}

function handleSlotClick(slotIdx) {
  if(!G.isPlayerTurn || G.phase!=='action') return;
  if(G.selectedCardIdx===null) {
    showMessage('Select a card from your hand first.','error');
    return;
  }
  const card = G.playerHand[G.selectedCardIdx];
  if(!canPlayCard(card, slotIdx)) {
    showMessage('Cannot play that card here. Check placement rules.','error');
    return;
  }
  // Wild needs declaration?
  if(card.type==='wild' && (!card.declaredElement || !card.declaredNumber)) {
    G.wildPending = { cardIdx: G.selectedCardIdx, forSlot: slotIdx };
    openWildModal(card);
    return;
  }
  commitPlay(G.selectedCardIdx, slotIdx);
}

function commitPlay(cardIdx, slotIdx) {
  const card = G.playerHand.splice(cardIdx,1)[0];
  G.selectedCardIdx = null;
  placeCard(card, slotIdx);
  G.cardsPlayedThisTurn++;

  // Check combos
  const combos = detectCombos();
  if(combos.length>0) {
    combos.forEach(c=>{
      showComboFlash(c);
      scoreCombo(c, true);
    });
    if(checkWin()) return;
  }

  // Titan: Fire — Flame Claw (active ability, handled via titan btn, not auto)
  // Eagle: Storm Talon — handled via button
  render();
  showMessage(`Card played. ${5-G.cardsPlayedThisTurn} plays remaining.`,'');
}

function playSelected() {
  // Try Titan ability if applicable
  if(G.selectedCardIdx===null && G.playerMage.id==='fire' && G.playerTitanLevel>=1 && !G.flameclawUsed) {
    triggerFlameClawUI();
    return;
  }
  if(G.selectedCardIdx===null) { showMessage('Select a card first.','error'); return; }
  // Find valid slots
  const card = G.playerHand[G.selectedCardIdx];
  const validSlots = getPlayableSlots(card);
  if(validSlots.length===0) { showMessage('No valid slots for this card.','error'); return; }
  if(validSlots.length===1) { handleSlotClick(validSlots[0]); return; }
  // Show slot picker if needed
  showSlotPicker('Play Card', 'Choose a Spell Slot', validSlots, (si)=>{
    closeModal('slot-modal');
    handleSlotClick(si);
  });
}

function discardSelected() {
  if(!G.isPlayerTurn || G.phase!=='action') return;
  // Show discard modal with hand
  const opts = document.getElementById('discard-modal-hand');
  opts.innerHTML = '';
  let selected = [];
  G.playerHand.forEach((card,i)=>{
    const div = document.createElement('div');
    div.className = 'modal-option';
    div.innerHTML = `<div class="modal-option-title">${cardLabel(card)}</div>`;
    div.onclick = ()=>{
      if(selected.includes(i)) {
        selected = selected.filter(x=>x!==i);
        div.style.borderColor='var(--border2)';
      } else if(selected.length<3) {
        selected.push(i);
        div.style.borderColor='var(--gold)';
      }
    };
    opts.appendChild(div);
  });
  G._pendingDiscardSelected = ()=>selected;
  openModal('discard-modal');
}

function confirmDiscard() {
  const selected = G._pendingDiscardSelected ? G._pendingDiscardSelected() : [];
  if(selected.length===0) { closeModal('discard-modal'); return; }
  const sorted = [...selected].sort((a,b)=>b-a);
  sorted.forEach(i=>{ G.discard.push(G.playerHand.splice(i,1)[0]); });
  // Draw replacements
  for(let i=0;i<sorted.length;i++) { if(G.deck.length||G.discard.length) G.playerHand.push(drawCard()); }
  closeModal('discard-modal');
  render();
  showMessage(`Discarded ${sorted.length} card(s) and drew replacements.`,'');
}

// ============================================================
// TITAN ABILITIES - PLAYER
// ============================================================
function triggerFlameClawUI() {
  if(G.flameclawUsed) { showMessage('Flame Claw already used this turn.','error'); return; }
  const fireSlots = G.slots.map((s,i)=>i).filter(i=>slotElement(G.slots[i])==='fire');
  if(fireSlots.length===0) { showMessage('No Fire slots available.','error'); return; }
  const maxSwaps = G.playerTitanLevel>=2 ? 3 : 1;
  showSlotPicker('Flame Claw', `Swap a Fire slot card with a hand card (up to ${maxSwaps})`, fireSlots, (si)=>{
    closeModal('slot-modal');
    // Choose hand card to swap in
    showHandPicker('Choose card from hand to place in slot', (hi)=>{
      const slotCard = slotTop(G.slots[si]);
      const handCard = G.playerHand.splice(hi,1)[0];
      G.slots[si].stack[G.slots[si].stack.length-1] = handCard;
      G.playerHand.push(slotCard);
      G.flameclawUsed = true;
      render();
      showMessage('Flame Claw used! Card swapped.','success');
    });
  });
}

function triggerStormTalonUI() {
  if(G.stormTalonUsed) { showMessage('Storm Talon already used this turn.','error'); return; }
  const nonEmpty = G.slots.map((s,i)=>i).filter(i=>G.slots[i].stack.length>0);
  if(nonEmpty.length<2) { showMessage('Need at least 2 non-empty slots.','error'); return; }
  showSlotPicker('Storm Talon', 'Choose slot to move top card FROM', nonEmpty, (fromIdx)=>{
    closeModal('slot-modal');
    const maxDist = G.playerTitanLevel>=2 ? 4 : 1;
    const valid = G.slots.map((_,i)=>i).filter(i=>i!==fromIdx && Math.abs(i-fromIdx)<=maxDist);
    showSlotPicker('Storm Talon', 'Move top card TO this slot', valid, (toIdx)=>{
      closeModal('slot-modal');
      const card = G.slots[fromIdx].stack.pop();
      G.slots[toIdx].stack.push(card);
      if(G.slots[fromIdx].stack.length===0) reloadSlot(fromIdx);
      G.stormTalonUsed = true;
      render();
      showMessage('Storm Talon used!','success');
    });
  });
}

function triggerFrostBiteUI() {
  if(G.frostBiteUsed) { showMessage('Frost Bite already used this turn.','error'); return; }
  const max = G.playerTitanLevel>=2 ? 2 : 1;
  // Discard up to max cards and draw
  const opts = document.getElementById('discard-modal-hand');
  opts.innerHTML = '';
  document.getElementById('discard-modal-title').textContent = `Frost Bite — Discard & Draw (up to ${max})`;
  let selected = [];
  G.playerHand.forEach((card,i)=>{
    const div = document.createElement('div');
    div.className = 'modal-option';
    div.innerHTML = `<div class="modal-option-title">${cardLabel(card)}</div>`;
    div.onclick = ()=>{
      if(selected.includes(i)) {
        selected = selected.filter(x=>x!==i);
        div.style.borderColor='var(--border2)';
      } else if(selected.length<max) {
        selected.push(i);
        div.style.borderColor='var(--gold)';
      }
    };
    opts.appendChild(div);
  });
  G._pendingDiscardSelected = ()=>selected;
  G._discardConfirmHook = ()=>{
    const s = selected;
    const sorted=[...s].sort((a,b)=>b-a);
    sorted.forEach(i=>G.discard.push(G.playerHand.splice(i,1)[0]));
    for(let i=0;i<sorted.length;i++) G.playerHand.push(drawCard());
