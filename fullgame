<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Mage Craft</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --fire: #e8541a; --fire-dark: #8b2500; --fire-glow: #ff6b2b;
  --water: #1a78e8; --water-dark: #00308b; --water-glow: #4da6ff;
  --air: #c8e81a; --air-dark: #5a7000; --air-glow: #e4ff4d;
  --earth: #3ae81a; --earth-dark: #006b00; --earth-glow: #5aff3a;
  --void: #9b1ae8; --void-dark: #3d0070; --void-glow: #c44dff;
  --gold: #c9a84c; --gold-light: #f0d080;
  --bg: #0a0610; --bg2: #110d1c; --bg3: #1a1428;
  --surface: #1e1830; --surface2: #261f3e;
  --border: #2e2550; --border2: #3d3268;
  --text: #e8e0f8; --text2: #a090c8; --text3: #6858a0;
  --radius: 12px; --radius-sm: 8px;
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: 'Crimson Pro', serif; }

/* ===== SCREENS ===== */
.screen { display: none; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; }
.screen.active { display: flex; }

/* ===== BACKGROUND ===== */
.arcane-bg {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background: radial-gradient(ellipse at 20% 20%, #1a0830 0%, transparent 50%),
              radial-gradient(ellipse at 80% 80%, #0a1830 0%, transparent 50%),
              radial-gradient(ellipse at 50% 50%, #0d0820 0%, var(--bg) 70%);
}
.arcane-bg::after {
  content: ''; position: absolute; inset: 0;
  background-image: radial-gradient(circle, #ffffff08 1px, transparent 1px);
  background-size: 40px 40px;
}

/* ===== TITLE SCREEN ===== */
#title-screen { align-items: center; justify-content: center; gap: 32px; position: relative; z-index: 1; }
.title-emblem { font-size: 80px; filter: drop-shadow(0 0 20px var(--void-glow)); animation: pulse 3s ease-in-out infinite; }
@keyframes pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.05);opacity:0.85} }
.title-main { font-family: 'Cinzel Decorative', serif; font-size: clamp(28px,8vw,48px); font-weight: 900; color: var(--gold-light); text-align: center; text-shadow: 0 0 30px var(--gold), 0 0 60px var(--void-glow); letter-spacing: 4px; }
.title-sub { font-family: 'Cinzel', serif; font-size: 14px; letter-spacing: 6px; color: var(--text2); text-transform: uppercase; }
.btn-primary { background: linear-gradient(135deg, #3d2870, #1e1440); border: 1px solid var(--gold); color: var(--gold-light); font-family: 'Cinzel', serif; font-size: 16px; letter-spacing: 2px; padding: 16px 40px; border-radius: 4px; cursor: pointer; transition: all 0.2s; box-shadow: 0 0 20px #00000080, inset 0 1px 0 #ffffff20; width: 100%; max-width: 280px; }
.btn-primary:active { transform: scale(0.97); box-shadow: 0 0 10px var(--gold) }
.btn-secondary { background: transparent; border: 1px solid var(--border2); color: var(--text2); font-family: 'Cinzel', serif; font-size: 14px; letter-spacing: 1px; padding: 12px 32px; border-radius: 4px; cursor: pointer; transition: all 0.2s; width: 100%; max-width: 280px; }
.btn-secondary:active { background: var(--surface); }

/* ===== MAGE SELECT ===== */
#mage-screen { overflow-y: auto; position: relative; z-index: 1; }
.screen-header { padding: 20px 20px 12px; text-align: center; flex-shrink: 0; }
.screen-title { font-family: 'Cinzel', serif; font-size: 18px; color: var(--gold-light); letter-spacing: 3px; }
.screen-subtitle { font-size: 13px; color: var(--text2); margin-top: 4px; }
.mage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 16px 24px; }
.mage-card { background: var(--surface); border: 2px solid var(--border); border-radius: var(--radius); padding: 16px 12px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; overflow: hidden; }
.mage-card.selected { border-color: var(--gold); box-shadow: 0 0 20px #c9a84c40; }
.mage-card.disabled { opacity: 0.4; pointer-events: none; }
.mage-card::before { content:''; position:absolute; inset:0; opacity:0; transition:opacity 0.2s; }
.mage-card[data-element=fire]::before { background: radial-gradient(circle at 50% 0%, #e8541a20, transparent 70%); }
.mage-card[data-element=water]::before { background: radial-gradient(circle at 50% 0%, #1a78e820, transparent 70%); }
.mage-card[data-element=air]::before { background: radial-gradient(circle at 50% 0%, #c8e81a20, transparent 70%); }
.mage-card[data-element=earth]::before { background: radial-gradient(circle at 50% 0%, #3ae81a20, transparent 70%); }
.mage-card.selected::before { opacity: 1; }
.mage-icon { font-size: 36px; }
.mage-name { font-family: 'Cinzel', serif; font-size: 13px; color: var(--text); text-align: center; }
.mage-titan { font-size: 11px; color: var(--text2); text-align: center; }
.mage-ability { font-size: 11px; color: var(--text3); text-align: center; line-height: 1.4; margin-top: 4px; }
.ability-badge { font-size: 10px; padding: 2px 8px; border-radius: 20px; margin-top: 4px; }
.confirm-row { padding: 12px 16px 32px; display: flex; flex-direction: column; gap: 8px; align-items: center; }

/* ===== GAME SCREEN ===== */
#game-screen { position: relative; z-index: 1; }
.game-layout { display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; }

/* Score bar */
.score-bar { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px 8px; background: var(--bg2); border-bottom: 1px solid var(--border); flex-shrink: 0; gap: 8px; }
.player-score { display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 80px; }
.player-label { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 1px; color: var(--text2); }
.player-name-display { font-size: 11px; color: var(--text3); }
.score-num { font-family: 'Cinzel Decorative', serif; font-size: 26px; color: var(--gold-light); line-height: 1; }
.score-target { font-size: 10px; color: var(--text3); }
.score-divider { font-family: 'Cinzel Decorative', serif; font-size: 18px; color: var(--border2); }
.titan-badge { display: flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 20px; border: 1px solid var(--border2); font-size: 10px; color: var(--text2); margin-top: 2px; }
.titan-badge.awakened { border-color: var(--gold); color: var(--gold); }
.titan-badge.enhanced { border-color: var(--fire-glow); color: var(--fire-glow); }

/* Status bar */
.status-bar { padding: 6px 14px; background: var(--bg3); border-bottom: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.turn-indicator { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 1px; color: var(--text2); }
.turn-indicator span { color: var(--gold-light); }
.phase-indicator { font-size: 11px; color: var(--text3); }
.item-tokens { display: flex; gap: 4px; }
.token-chip { width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--gold); display: flex; align-items: center; justify-content: center; font-size: 12px; background: var(--surface); cursor: pointer; }
.token-chip:active { transform: scale(0.9); }

/* Spell Slots */
.slots-area { padding: 10px 12px; background: var(--bg); border-bottom: 1px solid var(--border); flex-shrink: 0; }
.slots-label { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 2px; color: var(--text3); text-align: center; margin-bottom: 8px; text-transform: uppercase; }
.slots-row { display: flex; gap: 6px; justify-content: center; }
.spell-slot { flex: 1; max-width: 64px; min-height: 88px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; position: relative; overflow: hidden; padding: 4px; gap: 2px; }
.spell-slot.targetable { border-color: var(--gold); box-shadow: 0 0 12px #c9a84c60; animation: targetPulse 1s ease-in-out infinite; }
.spell-slot.selected-slot { border-color: var(--void-glow); box-shadow: 0 0 16px #c44dff60; }
.spell-slot.locked { border-color: #888; opacity: 0.7; }
.spell-slot.nulled { border-color: #555; opacity: 0.5; }
@keyframes targetPulse { 0%,100%{box-shadow:0 0 8px #c9a84c40} 50%{box-shadow:0 0 20px #c9a84c80} }
.slot-number-display { font-family: 'Cinzel Decorative', serif; font-size: 20px; line-height: 1; }
.slot-element-display { font-size: 9px; letter-spacing: 1px; text-transform: uppercase; }
.slot-stack-count { font-size: 9px; color: var(--text3); }
.slot-empty-label { font-size: 10px; color: var(--text3); }
.slot-lock-icon { position: absolute; top: 2px; right: 2px; font-size: 10px; }

.el-fire { color: var(--fire-glow); } .el-water { color: var(--water-glow); }
.el-air { color: var(--air-glow); } .el-earth { color: var(--earth-glow); }
.el-void { color: var(--void-glow); } .el-none { color: var(--text3); }

/* AI zone */
.ai-zone { padding: 6px 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; }
.ai-hand-display { display: flex; gap: 4px; }
.ai-card-back { width: 28px; height: 40px; background: linear-gradient(135deg, #1e1440, #2e1860); border: 1px solid var(--border2); border-radius: 4px; }
.ai-label { font-size: 10px; color: var(--text3); font-family: 'Cinzel', serif; letter-spacing: 1px; }

/* Message area */
.message-area { padding: 6px 14px; flex-shrink: 0; min-height: 32px; }
.game-message { font-size: 12px; color: var(--gold-light); text-align: center; font-style: italic; }
.game-message.error { color: #ff6060; }
.game-message.success { color: var(--earth-glow); }

/* Player hand */
.hand-area { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
.hand-label { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 2px; color: var(--text3); text-align: center; padding: 4px 0; flex-shrink: 0; }
.hand-scroll { overflow-x: auto; overflow-y: hidden; flex: 1; display: flex; align-items: center; padding: 4px 12px 8px; gap: 8px; scrollbar-width: none; }
.hand-scroll::-webkit-scrollbar { display: none; }
.card { width: 56px; min-width: 56px; height: 80px; border-radius: var(--radius-sm); border: 1.5px solid var(--border2); background: var(--surface2); display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.15s; position: relative; gap: 2px; flex-shrink: 0; }
.card:active { transform: scale(0.94); }
.card.selected { border-color: var(--gold); box-shadow: 0 0 16px #c9a84c60; transform: translateY(-8px); }
.card.played { opacity: 0.3; pointer-events: none; }
.card-number { font-family: 'Cinzel Decorative', serif; font-size: 22px; line-height: 1; }
.card-element { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; }
.card-icon { font-size: 18px; }
.card-type-label { font-size: 8px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; }
.card-corner { position: absolute; top: 3px; left: 5px; font-size: 9px; opacity: 0.7; }
.card.fire-card { background: linear-gradient(160deg, #1e0a00, var(--surface2)); border-color: var(--fire-dark); }
.card.fire-card.selected { border-color: var(--fire-glow); box-shadow: 0 0 16px #e8541a60; }
.card.water-card { background: linear-gradient(160deg, #00061e, var(--surface2)); border-color: var(--water-dark); }
.card.water-card.selected { border-color: var(--water-glow); box-shadow: 0 0 16px #1a78e860; }
.card.air-card { background: linear-gradient(160deg, #0e1400, var(--surface2)); border-color: var(--air-dark); }
.card.air-card.selected { border-color: var(--air-glow); box-shadow: 0 0 16px #c8e81a60; }
.card.earth-card { background: linear-gradient(160deg, #001400, var(--surface2)); border-color: var(--earth-dark); }
.card.earth-card.selected { border-color: var(--earth-glow); box-shadow: 0 0 16px #3ae81a60; }
.card.void-card { background: linear-gradient(160deg, #0d0020, var(--surface2)); border-color: var(--void-dark); }
.card.void-card.selected { border-color: var(--void-glow); box-shadow: 0 0 16px #9b1ae860; }
.card.wild-card { border-style: dashed; }

/* Action bar */
.action-bar { display: flex; gap: 6px; padding: 8px 12px 16px; flex-shrink: 0; background: var(--bg2); border-top: 1px solid var(--border); }
.btn-action { flex: 1; padding: 10px 4px; border-radius: var(--radius-sm); border: 1px solid var(--border2); background: var(--surface); color: var(--text2); font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 1px; cursor: pointer; transition: all 0.15s; }
.btn-action:active { transform: scale(0.96); background: var(--surface2); }
.btn-action.primary { background: linear-gradient(135deg, #3d2870, #1e1440); border-color: var(--gold); color: var(--gold-light); }
.btn-action.danger { border-color: var(--fire-dark); color: var(--fire-glow); }
.btn-action:disabled { opacity: 0.35; pointer-events: none; }

/* ===== MODALS ===== */
.modal-overlay { position: fixed; inset: 0; background: #00000090; z-index: 100; display: none; align-items: flex-end; }
.modal-overlay.active { display: flex; }
.modal-sheet { background: var(--bg2); border-radius: 20px 20px 0 0; border-top: 1px solid var(--border2); width: 100%; max-height: 80vh; overflow-y: auto; padding: 20px 20px 40px; }
.modal-handle { width: 40px; height: 4px; background: var(--border2); border-radius: 2px; margin: 0 auto 16px; }
.modal-title { font-family: 'Cinzel', serif; font-size: 16px; color: var(--gold-light); margin-bottom: 4px; text-align: center; }
.modal-subtitle { font-size: 13px; color: var(--text2); text-align: center; margin-bottom: 16px; }
.modal-options { display: flex; flex-direction: column; gap: 8px; }
.modal-option { background: var(--surface); border: 1px solid var(--border2); border-radius: var(--radius-sm); padding: 12px 16px; cursor: pointer; transition: all 0.15s; }
.modal-option:active { background: var(--surface2); border-color: var(--gold); }
.modal-option-title { font-family: 'Cinzel', serif; font-size: 14px; color: var(--text); }
.modal-option-desc { font-size: 12px; color: var(--text2); margin-top: 2px; }
.modal-btn-row { display: flex; gap: 8px; margin-top: 16px; }
.modal-btn { flex: 1; padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border2); background: var(--surface); color: var(--text2); font-family: 'Cinzel', serif; font-size: 13px; cursor: pointer; }
.modal-btn.confirm { border-color: var(--gold); color: var(--gold-light); background: linear-gradient(135deg, #3d2870, #1e1440); }
.modal-btn:active { transform: scale(0.97); }

/* Wild declare */
.declare-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin: 12px 0; }
.declare-btn { padding: 8px 4px; background: var(--surface); border: 1px solid var(--border2); border-radius: var(--radius-sm); color: var(--text); font-family: 'Cinzel', serif; font-size: 13px; cursor: pointer; text-align: center; }
.declare-btn:active { background: var(--surface2); border-color: var(--gold); }
.declare-elements { display: flex; gap: 8px; margin: 8px 0; }
.declare-el { flex: 1; padding: 10px 4px; background: var(--surface); border: 1px solid var(--border2); border-radius: var(--radius-sm); font-size: 11px; text-align: center; cursor: pointer; }
.declare-el:active { transform: scale(0.95); }

/* Attunement tracker */
.attunement-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
.streak-badge { font-size: 10px; padding: 2px 8px; border-radius: 20px; border: 1px solid var(--border2); color: var(--text2); }
.streak-badge.active { border-color: var(--gold); color: var(--gold); }
.streak-badge.ready { border-color: var(--earth-glow); color: var(--earth-glow); animation: pulse 1s ease-in-out infinite; }

/* Combo flash */
.combo-flash { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 200; pointer-events: none; text-align: center; animation: comboAnim 1.5s ease-out forwards; }
.combo-flash-title { font-family: 'Cinzel Decorative', serif; font-size: 28px; color: var(--gold-light); text-shadow: 0 0 20px var(--gold), 0 0 40px var(--void-glow); }
.combo-flash-pts { font-family: 'Cinzel', serif; font-size: 18px; color: var(--earth-glow); }
@keyframes comboAnim { 0%{opacity:0;transform:translate(-50%,-60%) scale(0.8)} 20%{opacity:1;transform:translate(-50%,-50%) scale(1.05)} 70%{opacity:1;transform:translate(-50%,-50%) scale(1)} 100%{opacity:0;transform:translate(-50%,-40%) scale(0.95)} }

/* Win screen */
#win-screen { align-items: center; justify-content: center; gap: 24px; position: relative; z-index: 1; }
.win-emblem { font-size: 80px; animation: pulse 2s ease-in-out infinite; }
.win-title { font-family: 'Cinzel Decorative', serif; font-size: 32px; color: var(--gold-light); text-shadow: 0 0 30px var(--gold); text-align: center; }
.win-subtitle { font-family: 'Cinzel', serif; font-size: 16px; color: var(--text2); letter-spacing: 2px; text-align: center; }
.win-scores { display: flex; gap: 32px; }
.win-score-block { text-align: center; }
.win-score-label { font-size: 12px; color: var(--text3); letter-spacing: 2px; }
.win-score-num { font-family: 'Cinzel Decorative', serif; font-size: 40px; color: var(--gold-light); }

/* Attunement panel */
.attunement-panel { padding: 8px 14px; background: var(--bg3); border-bottom: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.attunement-label { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 2px; color: var(--text3); flex-shrink: 0; }

/* Void Mage indicator */
.void-mage-btn { font-size: 10px; padding: 4px 10px; border-radius: 20px; border: 1px solid var(--void-glow); color: var(--void-glow); background: transparent; cursor: pointer; font-family: 'Cinzel', serif; animation: voidPulse 1.5s ease-in-out infinite; }
@keyframes voidPulse { 0%,100%{box-shadow:0 0 8px #c44dff40} 50%{box-shadow:0 0 20px #c44dff80} }

/* Rules modal */
.rules-section { margin-bottom: 16px; }
.rules-section-title { font-family: 'Cinzel', serif; font-size: 14px; color: var(--gold-light); margin-bottom: 6px; border-bottom: 1px solid var(--border); padding-bottom: 4px; }
.rules-text { font-size: 12px; color: var(--text2); line-height: 1.6; }
.rules-text li { margin: 4px 0 4px 16px; }

/* Scrollbar */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
</style>
</head>
<body>

<div class="arcane-bg"></div>

<!-- TITLE SCREEN -->
<div id="title-screen" class="screen active">
  <div class="title-emblem">⚗️</div>
  <div class="title-main">MAGE CRAFT</div>
  <div class="title-sub">The Elemental Duel</div>
  <button class="btn-primary" onclick="showScreen('mage-screen')">Begin</button>
  <button class="btn-secondary" onclick="showRules()">Rules</button>
</div>

<!-- MAGE SELECT SCREEN -->
<div id="mage-screen" class="screen">
  <div class="screen-header">
    <div class="screen-title">Choose Your Mage</div>
    <div class="screen-subtitle">Select your elemental affinity and Titan</div>
  </div>
  <div class="mage-grid" id="mage-grid"></div>
  <div class="confirm-row">
    <button class="btn-primary" id="start-game-btn" onclick="startGame()" disabled>Summon the Arena</button>
    <button class="btn-secondary" onclick="showScreen('title-screen')">Back</button>
  </div>
</div>

<!-- GAME SCREEN -->
<div id="game-screen" class="screen">
  <div class="game-layout">
    <!-- Score Bar -->
    <div class="score-bar">
      <div class="player-score">
        <div class="player-label">YOU</div>
        <div class="score-num" id="player-score">0</div>
        <div class="score-target">/ 50</div>
        <div class="titan-badge" id="player-titan-badge">🔒 Locked</div>
      </div>
      <div class="score-divider">⚔</div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:4px;">
        <div class="turn-indicator">Turn <span id="turn-num">1</span></div>
        <div id="void-mage-btn-container"></div>
      </div>
      <div class="score-divider">⚔</div>
      <div class="player-score">
        <div class="player-label">AI</div>
        <div class="score-num" id="ai-score">0</div>
        <div class="score-target">/ 50</div>
        <div class="titan-badge" id="ai-titan-badge">🔒 Locked</div>
      </div>
    </div>

    <!-- Status Bar -->
    <div class="status-bar">
      <div class="turn-indicator"><span id="current-turn-label">Your Turn</span></div>
      <div class="phase-indicator" id="phase-label">Draw Phase</div>
      <div class="item-tokens" id="player-tokens"></div>
    </div>

    <!-- Attunement -->
    <div class="attunement-panel">
      <div class="attunement-label">ATTUNEMENT</div>
      <div class="attunement-row" id="attunement-display"></div>
    </div>

    <!-- AI Zone -->
    <div class="ai-zone">
      <div class="ai-label">AI HAND</div>
      <div class="ai-hand-display" id="ai-hand-display"></div>
      <div style="font-size:10px;color:var(--text3)" id="ai-streak-display"></div>
    </div>

    <!-- Spell Slots -->
    <div class="slots-area">
      <div class="slots-label">Spell Slots</div>
      <div class="slots-row" id="slots-row"></div>
    </div>

    <!-- Message -->
    <div class="message-area">
      <div class="game-message" id="game-message">Draw your cards to begin.</div>
    </div>

    <!-- Hand -->
    <div class="hand-area">
